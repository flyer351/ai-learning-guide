---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { render } from 'astro:content';
import { paths, getPath } from '../../../data/paths';
import { allLessons, lessonsFor, pathOf, slugOf, type Lesson } from '../../../data/lessons';
import { url } from '../../../data/url';

export async function getStaticPaths() {
  const all = await allLessons();
  return all.map((l) => ({ params: { path: pathOf(l), lesson: slugOf(l) }, props: { lesson: l } }));
}
const { lesson } = Astro.props as { lesson: Lesson };
const path = getPath(pathOf(lesson))!;
const siblings = await lessonsFor(path.slug);
const i = siblings.findIndex((l) => l.id === lesson.id);
const prev = siblings[i - 1];
const next = siblings[i + 1];
const pathIdx = paths.findIndex((p) => p.slug === path.slug);
const nextPath = paths[pathIdx + 1];
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.summary}>
  <Fragment slot="top">
    <nav class="steps" aria-label={`Lesson ${i + 1} of ${siblings.length}`}>
      {siblings.map((l, n) => (
        <a href={url(`paths/${path.slug}/${slugOf(l)}`)} class={n < i ? 'done' : n === i ? 'on' : ''} aria-label={`Lesson ${n + 1}: ${l.data.title}`} aria-current={n === i ? 'page' : undefined}></a>
      ))}
    </nav>
  </Fragment>
  <article class="lesson">
    <a class="back" href={url(`paths/${path.slug}`)}>← {path.title}</a>
    <div class="label" style="margin-top:14px">Lesson {i + 1} of {siblings.length}</div>
    <h1>{lesson.data.title}</h1>
    <div class="chips"><span><Icon name="clock" /> {lesson.data.minutes} min</span><span><Icon name="info" /> {lesson.data.device}</span></div>
    <div class="prose"><Content /></div>
    {next ? (
      <a class="next" href={url(`paths/${path.slug}/${slugOf(next)}`)}><span><small>Up next · Lesson {i + 2}</small><b>{next.data.title}</b></span><span class="arrow">→</span></a>
    ) : (
      <a class="next" href={nextPath ? url(`paths/${nextPath.slug}`) : url('paths')}><span><small>You finished this path</small><b>{nextPath ? `Next path: ${nextPath.title}` : 'Back to all paths'}</b></span><span class="arrow">→</span></a>
    )}
    {prev && <a class="prev" href={url(`paths/${path.slug}/${slugOf(prev)}`)}>← Back to lesson {i}</a>}
  </article>
  <script>
    // Lesson lists are styled without bullets, which makes Safari's VoiceOver stop
    // announcing them as lists. An explicit role keeps them announced.
    document.querySelectorAll('.prose ol, .prose ul').forEach((l) => l.setAttribute('role', 'list'));

    // Adds a "Copy this message" button under each example prompt. Runs only in the reader's browser.
    const clip = '<svg class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3h6v1M9 10h6M9 14h6"/></svg>';
    const tick = '<svg class="icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg>';
    const idle = `${clip}<span>Copy this message</span>`;
    document.querySelectorAll('.try blockquote').forEach((q) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'copy';
      b.innerHTML = idle;
      const hint = document.createElement('p');
      hint.className = 'copy-hint';
      hint.setAttribute('role', 'status');
      let timer: ReturnType<typeof setTimeout>;
      b.addEventListener('click', async () => {
        const text = (q as HTMLElement).innerText.trim();
        clearTimeout(timer);
        try {
          await navigator.clipboard.writeText(text);
          b.innerHTML = `${tick}<span>Copied!</span>`;
          b.classList.add('done');
          hint.textContent = 'Now switch to your AI assistant, press and hold in its message box, and choose Paste.';
        } catch {
          const r = document.createRange(); r.selectNodeContents(q); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
          hint.textContent = 'The text is highlighted. Choose Copy from the menu that appears, or press Command-C (Ctrl-C on Windows).';
        }
        timer = setTimeout(() => { b.innerHTML = idle; b.classList.remove('done'); }, 4000);
      });
      q.after(b);
      b.after(hint);
    });

    // Walkthrough videos: play on their own (muted, looping) unless the reader has asked
    // their device to reduce motion. A Pause/Play button is always there.
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.demo').forEach((fig) => {
      const v = fig.querySelector('video');
      if (!v) return;
      v.removeAttribute('controls');
      const t = document.createElement('button');
      t.type = 'button';
      t.className = 'demo-toggle';
      const label = () => { t.textContent = v.paused ? '▶ Play the walkthrough' : '❚❚ Pause'; };
      t.addEventListener('click', () => { v.paused ? v.play() : v.pause(); });
      v.addEventListener('play', label);
      v.addEventListener('pause', label);
      v.addEventListener('click', () => { v.paused ? v.play() : v.pause(); });
      fig.querySelector('.demo-frame')?.after(t);
      if (!still) v.play().catch(() => {});
      label();
    });
  </script>
</Base>
