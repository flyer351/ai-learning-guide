---
import Base from '../../layouts/Base.astro';
import PathCard from '../../components/PathCard.astro';
import { paths } from '../../data/paths';
import { lessonsFor } from '../../data/lessons';
const counts = await Promise.all(paths.map(async (p) => (await lessonsFor(p.slug)).length));
---
<Base title="All learning paths" description="Six learning paths, from your first AI conversation to publishing an iPhone app or website.">
  <div class="wrap page">
    <h1>All learning paths</h1>
    <p class="lede">Each path is a short series of lessons. The first three build on each other. After that, pick the project that interests you.</p>
    <div class="grid">{paths.map((p, i) => <PathCard path={p} count={counts[i]} />)}</div>
  </div>
</Base>
